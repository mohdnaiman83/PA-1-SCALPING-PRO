        "\nRisk : " + str.tostring(rm_riskDistance) +
        "\nRR : 1 : " + str.tostring(rm_riskReward, "#.00") +
        "\nTP : " + str.tostring(rm_takeProfit),
        style = label.style_label_left,
        color = color.new(color.green, 70),
