// BUILD : 0.3.1 ALPHA
//======================================================================

//--------------------------------------------------
// RESET
//--------------------------------------------------

rm_riskReward := cfg_defaultRR

//--------------------------------------------------
// RISK : REWARD ENGINE
//--------------------------------------------------

if cfg_enableRisk and
   m12_canTrade and
   not na(rm_entry) and
   not na(rm_stopLoss) and
   not na(rm_takeProfit)

    float rewardDistance = math.abs(rm_takeProfit - rm_entry)

    if rm_riskDistance > 0

        rm_riskReward := rewardDistance / rm_riskDistance

//--------------------------------------------------
// LIMITER
//--------------------------------------------------

rm_riskReward := math.max(0.0,rm_riskReward)

//--------------------------------------------------
