//----------------------------------------------------
// CONSTANTS
//----------------------------------------------------

const int BIAS_BEAR      = -1
const int BIAS_BALANCED  = 0
const int BIAS_BULL      = 1

const int SIG_SELL    = -1
const int SIG_WAIT    = 0
const int SIG_BUY     = 1

const int STRENGTH_NONE         = 0
const int STRENGTH_WEAK         = 1
const int STRENGTH_MODERATE     = 2
const int STRENGTH_STRONG       = 3
const int STRENGTH_VERY_STRONG  = 4
const int STRENGTH_EXTREME      = 5

//----------------------------------------------------
// OUTPUT VARIABLES
//----------------------------------------------------

var int e_marketBias = BIAS_BALANCED

var int e_signalBias = SIG_WAIT

var int e_evidenceLevel = STRENGTH_NONE

var label g_evidenceDebug = na

//----------------------------------------------------
// VALIDATION
//----------------------------------------------------

e_evidenceReady :=
     cfg_enableEvidence and
     e_totalEvidence > 0

//----------------------------------------------------
// MARKET BIAS
//----------------------------------------------------

e_marketBias := BIAS_BALANCED

if e_evidenceReady

    if e_bullDominant and not e_scoreBalanced
        e_marketBias := BIAS_BULL

    else if e_bearDominant and not e_scoreBalanced
        e_marketBias := BIAS_BEAR

//----------------------------------------------------
// SIGNAL BIAS
//----------------------------------------------------

e_signalBias := SIG_WAIT

if e_marketBias == BIAS_BULL
    e_signalBias := SIG_BUY

else if e_marketBias == BIAS_BEAR
    e_signalBias := SIG_SELL

//----------------------------------------------------
// EVIDENCE STRENGTH
//----------------------------------------------------

e_evidenceLevel := STRENGTH_NONE

if e_evidenceReady

    if e_scoreDifference >= 80
        e_evidenceLevel := STRENGTH_EXTREME

    else if e_scoreDifference >= 60
        e_evidenceLevel := STRENGTH_VERY_STRONG

    else if e_scoreDifference >= 40
        e_evidenceLevel := STRENGTH_STRONG

    else if e_scoreDifference >= 20
        e_evidenceLevel := STRENGTH_MODERATE

    else
        e_evidenceLevel := STRENGTH_WEAK

//----------------------------------------------------
// DEBUG
//----------------------------------------------------

if cfg_showEvidenceDebug and barstate.islast

    if not na(g_evidenceDebug)
        label.delete(g_evidenceDebug)

    string biasText =
         e_marketBias == BIAS_BULL ? "BULLISH" :
         e_marketBias == BIAS_BEAR ? "BEARISH" :
         "BALANCED"

    string strengthText =
         e_evidenceLevel == STRENGTH_EXTREME ? "EXTREME" :
         e_evidenceLevel == STRENGTH_VERY_STRONG ? "VERY STRONG" :
         e_evidenceLevel == STRENGTH_STRONG ? "STRONG" :
         e_evidenceLevel == STRENGTH_MODERATE ? "MODERATE" :
         e_evidenceLevel == STRENGTH_WEAK ? "WEAK" :
         "NONE"

    g_evidenceDebug :=
         label.new(
             bar_index,
             high,
             "===== M10 =====" +
             "\nBull : " + str.tostring(e_bullScore, "#.0") + "%" +
             "\nBear : " + str.tostring(e_bearScore, "#.0") + "%" +
             "\nBias : " + biasText +
             "\nStrength : " + strengthText +
             "\nSignal : " + str.tostring(e_signalBias),
             style = label.style_label_left,
             color = color.new(color.blue, 70),
             textcolor = color.white,
             size = size.small)

