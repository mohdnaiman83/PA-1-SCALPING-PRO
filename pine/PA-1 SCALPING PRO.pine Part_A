//--------------------------------------------------

if cfg_enableRisk and
   cfg_enableBreakEven and
   m12_canTrade and
   not na(rm_entry) and
   not na(rm_stopLoss)

    if not na(rm_riskDistance)

        if m12_direction == DIR_LONG

            if high >= rm_entry + (rm_riskDistance * cfg_breakEvenRR)

                rm_breakEvenReady := true
                rm_breakEvenPrice := rm_entry

        else if m12_direction == DIR_SHORT

            if low <= rm_entry - (rm_riskDistance * cfg_breakEvenRR)

                rm_breakEvenReady := true
                rm_breakEvenPrice := rm_entry

//--------------------------------------------------
// DEBUG
//--------------------------------------------------

if cfg_showRiskDebug and barstate.islast

    if not na(g_riskDebug)
        label.delete(g_riskDebug)

    g_riskDebug := label.new(
        bar_index,
        high,
        "===== MODULE 13 BE =====" +
        "\nTrigger : " + str.tostring(cfg_breakEvenRR) + "R" +
        "\nReady : " + str.tostring(rm_breakEvenReady) +
        "\nBE Price : " + str.tostring(rm_breakEvenPrice),
        style = label.style_label_left,
        color = color.new(color.orange, 70),
        textcolor = color.white,
        size = size.small)

    //======================================================================
