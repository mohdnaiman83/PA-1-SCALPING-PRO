rm_setupReady := false

//--------------------------------------------------
// ENTRY ENGINE
//--------------------------------------------------

if cfg_enableRisk and m12_canTrade

    switch cfg_entryMode

        ENTRY_MARKET =>

            rm_entry := close

        ENTRY_LIMIT =>

            if m12_direction == DIR_LONG
                rm_entry := low
            else if m12_direction == DIR_SHORT
                rm_entry := high

        ENTRY_CONFIRM =>

            if m12_direction == DIR_LONG
                rm_entry := math.max(open, close)
            else if m12_direction == DIR_SHORT
                rm_entry := math.min(open, close)

//--------------------------------------------------
// SETUP READY
//--------------------------------------------------

    rm_setupReady := not na(rm_entry)

