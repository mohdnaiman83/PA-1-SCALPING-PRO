// DEBUG
//--------------------------------------------------

if cfg_showRiskDebug and barstate.islast

    if not na(g_riskDebug)
        label.delete(g_riskDebug)

    string rm_slModeText =
         cfg_stopLossMode == SL_STRUCTURE ? "STRUCTURE" :
         cfg_stopLossMode == SL_ATR ? "ATR" :
         "FIXED"

