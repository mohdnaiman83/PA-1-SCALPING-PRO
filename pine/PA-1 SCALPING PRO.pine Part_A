    group = GROUP_RISK)

//--------------------------------------------------
// RESET
//--------------------------------------------------

rm_stopLoss := na

//--------------------------------------------------
// STOP LOSS ENGINE
//--------------------------------------------------

if cfg_enableRisk and m12_canTrade

    switch cfg_stopLossMode

        //--------------------------------------------------
        // STRUCTURE STOP
        //--------------------------------------------------

        SL_STRUCTURE =>

            if m12_direction == DIR_LONG
                rm_stopLoss := m05_lastSwingLow - (cfg_slBufferTicks * syminfo.mintick)

            else if m12_direction == DIR_SHORT
                rm_stopLoss := m05_lastSwingHigh + (cfg_slBufferTicks * syminfo.mintick)

        //--------------------------------------------------
        // ATR STOP
        //--------------------------------------------------

        SL_ATR =>

            if m12_direction == DIR_LONG
                rm_stopLoss := rm_entry - m03_atr

            else if m12_direction == DIR_SHORT
                rm_stopLoss := rm_entry + m03_atr

        //--------------------------------------------------
        // FIXED STOP
        //--------------------------------------------------

        SL_FIXED =>

            if m12_direction == DIR_LONG
                rm_stopLoss := rm_entry - (cfg_fixedSLTicks * syminfo.mintick)

            else if m12_direction == DIR_SHORT
                rm_stopLoss := rm_entry + (cfg_fixedSLTicks * syminfo.mintick)

//--------------------------------------------------
// VALIDATION
//--------------------------------------------------

if not na(rm_entry) and not na(rm_stopLoss)

    if m12_direction == DIR_LONG and rm_stopLoss >= rm_entry
        rm_stopLoss := na

    else if m12_direction == DIR_SHORT and rm_stopLoss <= rm_entry
        rm_stopLoss := na

