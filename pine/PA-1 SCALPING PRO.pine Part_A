//======================================================================
// MODULE 12.04 - DECISION ENGINE
// BUILD : 0.3.0 ALPHA
//======================================================================

//--------------------------------------------------
// RESET
//--------------------------------------------------

ex_decision := EXEC_NO_TRADE
ex_canTrade := false
ex_reason := "Engine Disabled"

//--------------------------------------------------
// DECISION ENGINE
//--------------------------------------------------

if cfg_enableExecution

    if not m10_ready

        ex_decision := EXEC_WAIT
        ex_reason := "Evidence Not Ready"

    else if not m11_tradeReady

        ex_decision := EXEC_WAIT
        ex_reason := "Trade Not Ready"

    else if m10_marketBias == BIAS_BULL and m10_signalBias == SIG_BUY

        ex_decision := EXEC_BUY
        ex_canTrade := true
        ex_reason := "Bullish Confirmation"

    else if m10_marketBias == BIAS_BEAR and m10_signalBias == SIG_SELL

        ex_decision := EXEC_SELL
        ex_canTrade := true
        ex_reason := "Bearish Confirmation"

    else

        ex_decision := EXEC_WAIT
        ex_canTrade := false
        ex_reason := "Bias Conflict"

    //======================================================================
// MODULE 12.05 - VALIDATION ENGINE
// BUILD : 0.3.0 ALPHA
//======================================================================

//--------------------------------------------------
// VALIDATION
//--------------------------------------------------

bool ex_validDecision = ex_decision == EXEC_BUY or ex_decision == EXEC_SELL

bool ex_validConfidence = m11_confidence >= cfg_minConfidence

bool ex_validGrade = m11_grade >= cfg_minGrade

bool ex_validBias = false

if ex_decision == EXEC_BUY
    ex_validBias := m10_marketBias == BIAS_BULL and m10_signalBias == SIG_BUY
else if ex_decision == EXEC_SELL
    ex_validBias := m10_marketBias == BIAS_BEAR and m10_signalBias == SIG_SELL

//--------------------------------------------------
// EXECUTION VALIDATION
//--------------------------------------------------

if cfg_enableExecution

    ex_canTrade := false

    if not m11_tradeReady

        ex_reason := "Trade Not Ready"

    else if not ex_validDecision

        ex_reason := "No Valid Decision"

    else if not ex_validConfidence

        ex_reason := "Low Confidence"

    else if not ex_validGrade

        ex_reason := "Low Grade"

    else if not ex_validBias

        ex_reason := "Bias Conflict"

    else

        ex_canTrade := true
        ex_reason := "Execution Approved"

//--------------------------------------------------
// FAIL SAFE
//--------------------------------------------------

if not ex_canTrade

    if ex_decision == EXEC_BUY or ex_decision == EXEC_SELL

        ex_decision := EXEC_WAIT

    //======================================================================
// MODULE 12.06 - OUTPUT ENGINE
// BUILD : 0.3.0 ALPHA
//======================================================================

//--------------------------------------------------
// RESET
//--------------------------------------------------

ex_direction := DIR_NONE
ex_status := "NO TRADE"
ex_text := "No Valid Setup"
ex_color := color.gray

//--------------------------------------------------
// OUTPUT ENGINE
//--------------------------------------------------

if cfg_enableExecution

    switch ex_decision

        EXEC_BUY =>

            if ex_canTrade

                ex_direction := DIR_LONG
                ex_status := "BUY"
                ex_text := "BUY CONFIRMED"
                ex_color := color.lime

            else

                ex_status := "WAIT"
                ex_text := ex_reason
                ex_color := color.orange

        EXEC_SELL =>

            if ex_canTrade

                ex_direction := DIR_SHORT
                ex_status := "SELL"
                ex_text := "SELL CONFIRMED"
                ex_color := color.red

            else

                ex_status := "WAIT"
                ex_text := ex_reason
                ex_color := color.orange

        EXEC_WAIT =>

            ex_status := "WAIT"
            ex_text := ex_reason
            ex_color := color.orange

        =>

            ex_status := "NO TRADE"
            ex_text := ex_reason
            ex_color := color.gray

//--------------------------------------------------
// DEBUG
//--------------------------------------------------

if cfg_showExecutionDebug and barstate.islast

    if not na(g_executionDebug)
        label.delete(g_executionDebug)

    g_executionDebug := label.new(
        bar_index,
        high,
        "===== MODULE 12 =====" +
        "\nStatus : " + ex_status +
        "\nDecision : " + str.tostring(ex_decision) +
        "\nDirection : " + str.tostring(ex_direction) +
        "\nApproved : " + str.tostring(ex_canTrade) +
        "\nReason : " + ex_reason,
        style = label.style_label_left,
        color = ex_canTrade ? color.new(color.green, 70) : color.new(color.red, 70),
        textcolor = color.white,
        size = size.small)

