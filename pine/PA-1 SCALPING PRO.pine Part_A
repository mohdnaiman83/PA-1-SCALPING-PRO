//--------------------------------------------------
// TAKE PROFIT ENGINE
//--------------------------------------------------

if cfg_enableRisk and m12_canTrade and not na(rm_riskDistance)

    if m12_direction == DIR_LONG

        rm_takeProfit := rm_entry + (rm_riskDistance * rm_riskReward)

    else if m12_direction == DIR_SHORT

        rm_takeProfit := rm_entry - (rm_riskDistance * rm_riskReward)

//--------------------------------------------------
// VALIDATION
//--------------------------------------------------

if not na(rm_entry) and not na(rm_takeProfit)

    if m12_direction == DIR_LONG and rm_takeProfit <= rm_entry

        rm_takeProfit := na

    else if m12_direction == DIR_SHORT and rm_takeProfit >= rm_entry

        rm_takeProfit := na

//--------------------------------------------------
// DEBUG
//--------------------------------------------------

if cfg_showRiskDebug and barstate.islast

    if not na(g_riskDebug)
        label.delete(g_riskDebug)

    g_riskDebug := label.new(
