//======================================================================

//----------------------------------------------------
// DOMINANT SIDE
//----------------------------------------------------

e_bullDominant := false
e_bearDominant := false
e_scoreBalanced := false

if e_totalEvidence > 0

    if e_scoreDifference <= 5.0

        e_scoreBalanced := true

    else

        if e_bullScore > e_bearScore

            e_bullDominant := true

        if e_bearScore > e_bullScore

            e_bearDominant := true

