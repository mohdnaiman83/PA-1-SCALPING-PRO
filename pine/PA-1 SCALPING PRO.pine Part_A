//======================================================================
// MODULE 10.04 - EVIDENCE SCORE ENGINE
// BUILD : 0.2.0 ALPHA
//
// PURPOSE
// Convert Bull / Bear Evidence into percentage score.
//
// INPUTS
// e_bullEvidence
// e_bearEvidence
//
// OUTPUTS
// e_totalEvidence
// e_bullScore
// e_bearScore
// e_scoreDifference
//
// CHANGE LOG
// v0.2.0 ALPHA
// • Initial implementation
//======================================================================

//----------------------------------------------------
// TOTAL EVIDENCE
//----------------------------------------------------

e_totalEvidence :=
     e_bullEvidence +
     e_bearEvidence

//----------------------------------------------------
// SCORE CALCULATION
//----------------------------------------------------

if e_totalEvidence > 0

    e_bullScore :=
         (float(e_bullEvidence) / float(e_totalEvidence)) * 100.0

    e_bearScore :=
         (float(e_bearEvidence) / float(e_totalEvidence)) * 100.0

else

    e_bullScore := 0.0
    e_bearScore := 0.0

//----------------------------------------------------
// SCORE LIMITER
//----------------------------------------------------

e_bullScore :=
     math.max(
         0.0,
         math.min(
             100.0,
             e_bullScore))

e_bearScore :=
     math.max(
         0.0,
         math.min(
             100.0,
             e_bearScore))

//----------------------------------------------------
// SCORE DIFFERENCE
//----------------------------------------------------

e_scoreDifference :=
     math.abs(
         e_bullScore -
         e_bearScore)

//----------------------------------------------------
// DEBUG
//----------------------------------------------------

if cfg_showEvidenceDebug

    label.new(
         bar_index,
         high,
         "Bull Evidence : " + str.tostring(e_bullEvidence) +
         "\nBear Evidence : " + str.tostring(e_bearEvidence) +
         "\nTotal Evidence : " + str.tostring(e_totalEvidence) +
         "\nBull Score : " + str.tostring(e_bullScore, "#.00") + "%" +
         "\nBear Score : " + str.tostring(e_bearScore, "#.00") + "%" +
         "\nDifference : " + str.tostring(e_scoreDifference, "#.00"),
         style = label.style_label_down,
         color = color.new(color.blue, 75),
         textcolor = color.white,
         size = size.small)

