bool e_tradeReady = false

string e_tradeStatus = "WAIT"

//======================================================================
// MODULE 11.04 - CONFIDENCE ENGINE
// BUILD : 0.3.0 ALPHA
//======================================================================

//--------------------------------------------------
// RESET
//--------------------------------------------------

e_tradeConfidence := 0.0

float evidenceBonus = 0.0

//--------------------------------------------------
// ENGINE
//--------------------------------------------------

if cfg_enableInterpreter and m10_ready

    // Base Confidence
    e_tradeConfidence := m10_scoreDifference

    // Evidence Bonus
    switch m10_evidenceLevel
        STRENGTH_MODERATE =>
            evidenceBonus := 5.0

        STRENGTH_STRONG =>
            evidenceBonus := 10.0

        STRENGTH_VERY_STRONG =>
            evidenceBonus := 15.0

        STRENGTH_EXTREME =>
            evidenceBonus := 20.0

        =>
            evidenceBonus := 0.0

    // Final Confidence
    e_tradeConfidence += evidenceBonus

//--------------------------------------------------
// LIMITER
//--------------------------------------------------

e_tradeConfidence := math.max(
    0.0,
    math.min(
        100.0,
        e_tradeConfidence))

    //======================================================================
// MODULE 11.05 - TRADE GRADE ENGINE
// BUILD : 0.3.0 ALPHA
//======================================================================

//--------------------------------------------------
// RESET
//--------------------------------------------------

e_tradeGrade := GRADE_NO_TRADE
e_tradeGradeText := "NO TRADE"

//--------------------------------------------------
// ENGINE
//--------------------------------------------------

if cfg_enableInterpreter and m10_ready

    if e_tradeConfidence >= 90.0
        e_tradeGrade := GRADE_A_PLUS

    else if e_tradeConfidence >= 80.0
        e_tradeGrade := GRADE_A

    else if e_tradeConfidence >= 70.0
        e_tradeGrade := GRADE_B

    else if e_tradeConfidence >= 60.0
        e_tradeGrade := GRADE_C

//--------------------------------------------------
// GRADE TEXT
//--------------------------------------------------

switch e_tradeGrade

    GRADE_A_PLUS =>
        e_tradeGradeText := "A+"

    GRADE_A =>
        e_tradeGradeText := "A"

    GRADE_B =>
        e_tradeGradeText := "B"

    GRADE_C =>
        e_tradeGradeText := "C"

    =>
        e_tradeGradeText := "NO TRADE"

    //======================================================================
//======================================================================
// MODULE 11.06 - TRADE QUALIFICATION ENGINE
//======================================================================

e_tradeReady := false
e_tradeStatus := "NO TRADE"

bool validEvidence   = m10_ready
bool validBias       = m10_marketBias != BIAS_BALANCED
bool validSignal     = m10_signalBias != SIG_WAIT
bool validConfidence = e_tradeConfidence >= cfg_minConfidence
bool validGrade      = e_tradeGrade >= cfg_minGrade

if cfg_enableInterpreter
    if validEvidence and validBias and validSignal and validConfidence and validGrade
        e_tradeReady := true

if e_tradeReady
    if m10_signalBias == SIG_BUY
        e_tradeStatus := "BUY"
    else if m10_signalBias == SIG_SELL
        e_tradeStatus := "SELL"
    else
        e_tradeStatus := "WAIT"

