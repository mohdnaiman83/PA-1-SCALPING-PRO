// BUILD : 0.3.1 ALPHA
//======================================================================

//--------------------------------------------------
// RESET
//--------------------------------------------------

rm_ready := false
rm_riskValid := false
rm_validationReason := "UNKNOWN"

//--------------------------------------------------
// VALIDATION
//--------------------------------------------------

if not cfg_enableRisk

    rm_validationReason := "Risk Engine Disabled"

else if not m12_canTrade

    rm_validationReason := "Execution Not Approved"

else if na(rm_entry)

    rm_validationReason := "Invalid Entry"

else if na(rm_stopLoss)

    rm_validationReason := "Invalid Stop Loss"

else if na(rm_takeProfit)

    rm_validationReason := "Invalid Take Profit"

else if rm_stopLoss == rm_entry

    rm_validationReason := "Zero Risk"

else

    rm_riskValid := true
    rm_ready := true
    rm_validationReason := "Risk Model Valid"

//--------------------------------------------------
// STATUS
//--------------------------------------------------

rm_status := RM_INVALID
rm_statusText := "INVALID"
rm_color := color.red

if rm_ready and rm_setupReady

    rm_status := RM_READY
    rm_statusText := "READY"
    rm_color := color.lime

//--------------------------------------------------
// DEBUG
//--------------------------------------------------

if cfg_showRiskDebug and barstate.islast

    if not na(g_riskDebug)
        label.delete(g_riskDebug)

    g_riskDebug := label.new(
        bar_index,
        high,
        "===== MODULE 13 VALIDATION =====" +
        "\nReady : " + str.tostring(rm_ready) +
        "\nValid : " + str.tostring(rm_riskValid) +
        "\nReason : " + rm_validationReason,
        style = label.style_label_left,
        color = color.new(rm_color, 70),
        textcolor = color.white,
        size = size.small)

    //======================================================================
// MODULE 13.10 - OUTPUT ENGINE
// BUILD : 0.3.1 ALPHA
//======================================================================

//--------------------------------------------------
// OUTPUT STATUS
//--------------------------------------------------

if rm_ready

    if rm_breakEvenReady

        rm_status := RM_BE
        rm_statusText := "BREAK EVEN"
        rm_color := color.orange

    else

        rm_status := RM_READY
        rm_statusText := "READY"
        rm_color := color.lime

else

    rm_status := RM_INVALID
    rm_statusText := "INVALID"
    rm_color := color.red

//--------------------------------------------------
// DEBUG
//--------------------------------------------------

if cfg_showRiskDebug and barstate.islast

    if not na(g_riskDebug)
        label.delete(g_riskDebug)

    g_riskDebug := label.new(
         bar_index,
         high,
         "===== MODULE 13 OUTPUT =====" +
         "\nStatus : " + rm_statusText +
         "\nEntry : " + str.tostring(rm_entry) +
         "\nSL : " + str.tostring(rm_stopLoss) +
         "\nTP : " + str.tostring(rm_takeProfit) +
         "\nBE : " + str.tostring(rm_breakEvenReady),
         style = label.style_label_left,
         color = color.new(rm_color, 70),
         textcolor = color.white,
         size = size.small)

