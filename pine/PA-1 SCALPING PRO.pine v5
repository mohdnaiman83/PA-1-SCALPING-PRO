//======================================================================
// MODULE 03.01 - MARKET ENGINE CONFIGURATION
// BUILD : 0.3.0
//======================================================================

string GROUP_MARKET = "Market Engine"

int cfg_atrLength = input.int(14, "ATR Length", minval = 1, group = GROUP_MARKET)

float cfg_volatilityMultiplier = input.float(1.5, "Volatility Multiplier", minval = 0.1, step = 0.1, group = GROUP_MARKET)

bool cfg_enableMarketFilter = input.bool(true, "Enable Market Filter", group = GROUP_MARKET)

//======================================================================
// MODULE 03.02 - ATR ENGINE
// BUILD : 0.3.1
//======================================================================

//----------------------------------------------------
// ATR CALCULATION
//----------------------------------------------------

float e_atr = ta.atr(cfg_atrLength)

//----------------------------------------------------
// CURRENT RANGE
//----------------------------------------------------

float e_currentRange = high - low

//----------------------------------------------------
// VOLATILITY CHECK
//----------------------------------------------------

bool e_marketVolatile = e_currentRange > (e_atr * cfg_volatilityMultiplier)

//======================================================================
// MODULE 03.03 - MARKET STATE ENGINE
// BUILD : 0.3.2
//======================================================================

//----------------------------------------------------
// MARKET EXPANSION
//----------------------------------------------------

bool e_marketExpansion = e_currentRange > e_atr

//----------------------------------------------------
// MARKET COMPRESSION
//----------------------------------------------------

bool e_marketCompression = e_currentRange < e_atr

//----------------------------------------------------
// MARKET READY
//----------------------------------------------------

bool e_marketReady = not cfg_enableMarketFilter or e_marketVolatile

//======================================================================
// MODULE 03.04 - MARKET TREND FILTER
// BUILD : 0.3.3
//======================================================================

//----------------------------------------------------
// EMA SETTINGS
//----------------------------------------------------

int cfg_fastEMA = input.int(20, "Fast EMA", minval = 1, group = GROUP_MARKET)

int cfg_slowEMA = input.int(50, "Slow EMA", minval = 2, group = GROUP_MARKET)

//----------------------------------------------------
// EMA CALCULATION
//----------------------------------------------------

float e_fastEMA = ta.ema(close, cfg_fastEMA)

float e_slowEMA = ta.ema(close, cfg_slowEMA)

//----------------------------------------------------
// MARKET TREND
//----------------------------------------------------

bool e_marketBullish = e_fastEMA > e_slowEMA

bool e_marketBearish = e_fastEMA < e_slowEMA

bool e_marketTrending = e_marketBullish or e_marketBearish

//======================================================================
// MODULE 03.05 - MARKET CONFIDENCE ENGINE
// BUILD : 0.3.4
//======================================================================

//----------------------------------------------------
// MARKET CONFIDENCE SCORE
//----------------------------------------------------

int e_marketConfidence = 0

e_marketConfidence := 0

if e_sessionActive
    e_marketConfidence += 20

if e_marketReady
    e_marketConfidence += 30

if e_marketTrending
    e_marketConfidence += 30

if e_marketExpansion
    e_marketConfidence += 20

//----------------------------------------------------
// MARKET STATUS
//----------------------------------------------------

bool e_marketStrong = e_marketConfidence >= 80

//======================================================================
// MODULE 04.01 - HTF CONFIGURATION
// BUILD : 0.4.0
//======================================================================

string GROUP_HTF = "HTF Engine"

//----------------------------------------------------
// HIGHER TIMEFRAME
//----------------------------------------------------

string cfg_htfPrimary = input.timeframe("240", "Primary HTF", group = GROUP_HTF)

string cfg_htfSecondary = input.timeframe("60", "Secondary HTF", group = GROUP_HTF)

//----------------------------------------------------
// HTF FILTER
//----------------------------------------------------

bool cfg_enableHTFFilter = input.bool(true, "Enable HTF Filter", group = GROUP_HTF)

//======================================================================
// MODULE 04.02 - HTF EMA ENGINE
// BUILD : 0.4.1
//======================================================================

//----------------------------------------------------
// HTF EMA SETTINGS
//----------------------------------------------------

int cfg_htfFastEMA = input.int(20, "HTF Fast EMA", minval = 1, group = GROUP_HTF)

int cfg_htfSlowEMA = input.int(50, "HTF Slow EMA", minval = 2, group = GROUP_HTF)

//----------------------------------------------------
// HTF EMA VALUES
//----------------------------------------------------

float e_htfFastEMA = request.security(syminfo.tickerid, cfg_htfPrimary, ta.ema(close, cfg_htfFastEMA))

float e_htfSlowEMA = request.security(syminfo.tickerid, cfg_htfPrimary, ta.ema(close, cfg_htfSlowEMA))

//----------------------------------------------------
// HTF TREND
//----------------------------------------------------

bool e_htfBullish = e_htfFastEMA > e_htfSlowEMA

bool e_htfBearish = e_htfFastEMA < e_htfSlowEMA

//======================================================================
// MODULE 04.03 - HTF ALIGNMENT ENGINE
// BUILD : 0.4.2
//======================================================================

//----------------------------------------------------
// SECONDARY HTF EMA
//----------------------------------------------------

float e_htf2FastEMA = request.security(syminfo.tickerid, cfg_htfSecondary, ta.ema(close, cfg_htfFastEMA))

float e_htf2SlowEMA = request.security(syminfo.tickerid, cfg_htfSecondary, ta.ema(close, cfg_htfSlowEMA))

//----------------------------------------------------
// SECONDARY HTF TREND
//----------------------------------------------------

bool e_htf2Bullish = e_htf2FastEMA > e_htf2SlowEMA

bool e_htf2Bearish = e_htf2FastEMA < e_htf2SlowEMA

//----------------------------------------------------
// HTF ALIGNMENT
//----------------------------------------------------

bool e_htfAlignedBullish = e_htfBullish and e_htf2Bullish

bool e_htfAlignedBearish = e_htfBearish and e_htf2Bearish

bool e_htfReady = not cfg_enableHTFFilter or e_htfAlignedBullish or e_htfAlignedBearish

//======================================================================
// MODULE 05.01 - STRUCTURE CONFIGURATION
// BUILD : 0.5.0
//======================================================================

string GROUP_STRUCTURE = "Structure Engine"

//----------------------------------------------------
// SWING SETTINGS
//----------------------------------------------------

int cfg_swingLength = input.int(5, "Swing Length", minval = 2, group = GROUP_STRUCTURE)

//----------------------------------------------------
// STRUCTURE FILTER
//----------------------------------------------------

bool cfg_enableStructureFilter = input.bool(true, "Enable Structure Filter", group = GROUP_STRUCTURE)

//======================================================================
// MODULE 05.02 - SWING ENGINE
// BUILD : 0.5.1
//======================================================================

//----------------------------------------------------
// SWING DETECTION
//----------------------------------------------------

float e_swingHigh = ta.pivothigh(high, cfg_swingLength, cfg_swingLength)

float e_swingLow = ta.pivotlow(low, cfg_swingLength, cfg_swingLength)

//----------------------------------------------------
// LAST CONFIRMED SWINGS
//----------------------------------------------------

float e_lastSwingHigh = ta.valuewhen(not na(e_swingHigh), e_swingHigh, 0)

float e_lastSwingLow = ta.valuewhen(not na(e_swingLow), e_swingLow, 0)

//----------------------------------------------------
// SWING READY
//----------------------------------------------------

bool e_swingReady = not na(e_lastSwingHigh) and not na(e_lastSwingLow)

//======================================================================
// MODULE 05.03 - BOS ENGINE
// BUILD : 0.5.2
//======================================================================

//----------------------------------------------------
// BREAK OF STRUCTURE
//----------------------------------------------------

bool e_bosBullish = e_swingReady and close > e_lastSwingHigh

bool e_bosBearish = e_swingReady and close < e_lastSwingLow

//----------------------------------------------------
// STRUCTURE DIRECTION
//----------------------------------------------------

bool e_structureBullish = e_bosBullish

bool e_structureBearish = e_bosBearish

//----------------------------------------------------
// BOS READY
//----------------------------------------------------

bool e_bosReady = e_bosBullish or e_bosBearish

//======================================================================
// MODULE 05.04 - CHOCH ENGINE
// BUILD : 0.5.3
//======================================================================

//----------------------------------------------------
// CHANGE OF CHARACTER
//----------------------------------------------------

bool e_chochBullish =
     e_structureBearish[1] and
     e_bosBullish

bool e_chochBearish =
     e_structureBullish[1] and
     e_bosBearish

//----------------------------------------------------
// CHOCH READY
//----------------------------------------------------

bool e_chochReady =
     e_chochBullish or
     e_chochBearish

    //======================================================================
// MODULE 05.05 - STRUCTURE STATE ENGINE
// BUILD : 0.5.4
//======================================================================

//----------------------------------------------------
// STRUCTURE STATE
//----------------------------------------------------

bool e_structureUptrend = e_bosBullish and not e_chochBearish

bool e_structureDowntrend = e_bosBearish and not e_chochBullish

bool e_structureTransition =
     e_chochBullish or
     e_chochBearish

bool e_structureRange =
     not e_structureUptrend and
     not e_structureDowntrend and
     not e_structureTransition

//----------------------------------------------------
// STRUCTURE READY
//----------------------------------------------------

bool e_structureReady =
     e_bosReady or
     e_chochReady

    //======================================================================
// MODULE 05.06 - STRUCTURE CONFIDENCE
// BUILD : 0.5.6
//======================================================================

//----------------------------------------------------
// STRUCTURE CONFIDENCE
//----------------------------------------------------

int e_structureConfidence = 0

e_structureConfidence := 0

if e_swingReady
    e_structureConfidence += 20

if e_bosReady
    e_structureConfidence += 30

if e_chochReady
    e_structureConfidence += 20

if e_structureReady
    e_structureConfidence += 30

//----------------------------------------------------
// STRUCTURE STRONG
//----------------------------------------------------

bool e_structureStrong = e_structureConfidence >= 70

//======================================================================
// MODULE 06.01 - LIQUIDITY CONFIGURATION
// BUILD : 0.6.0
//======================================================================

string GROUP_LIQUIDITY = "Liquidity Engine"

//----------------------------------------------------
// LIQUIDITY SETTINGS
//----------------------------------------------------

int cfg_liquidityLookback = input.int(20, "Liquidity Lookback", minval = 5, group = GROUP_LIQUIDITY)

bool cfg_enableLiquidityFilter = input.bool(true, "Enable Liquidity Filter", group = GROUP_LIQUIDITY)

//======================================================================
// MODULE 06.02 - BUY SIDE LIQUIDITY ENGINE
// BUILD : 0.6.1
//======================================================================

//----------------------------------------------------
// BUY SIDE LIQUIDITY
//----------------------------------------------------

float e_buySideLiquidity = ta.highest(high, cfg_liquidityLookback)

//----------------------------------------------------
// BUY SIDE SWEEP
//----------------------------------------------------

bool e_buySideSweep = high > e_buySideLiquidity[1]

//----------------------------------------------------
// BUY SIDE READY
//----------------------------------------------------

bool e_buySideReady = e_buySideSweep

//======================================================================
// MODULE 06.03 - SELL SIDE LIQUIDITY ENGINE
// BUILD : 0.6.2
//======================================================================

float e_sellSideLiquidity = ta.lowest(low, cfg_liquidityLookback)

bool e_sellSideSweep = low < e_sellSideLiquidity[1]

bool e_sellSideReady = e_sellSideSweep

//======================================================================
// MODULE 06.04 - LIQUIDITY SWEEP ENGINE
// BUILD : 0.6.3
//======================================================================

bool e_liquidityBullish = e_sellSideSweep

bool e_liquidityBearish = e_buySideSweep

bool e_liquiditySweep = e_liquidityBullish or e_liquidityBearish

bool e_liquidityReady = not cfg_enableLiquidityFilter or e_liquiditySweep

//======================================================================
// MODULE 06.05 - LIQUIDITY CONFIDENCE ENGINE
// BUILD : 0.6.4
//======================================================================

int e_liquidityConfidence = 0

e_liquidityConfidence := 0

if e_buySideReady
    e_liquidityConfidence += 30

if e_sellSideReady
    e_liquidityConfidence += 30

if e_liquiditySweep
    e_liquidityConfidence += 40

bool e_liquidityStrong = e_liquidityConfidence >= 70

//======================================================================
// MODULE 07.01 - PREMIUM / DISCOUNT CONFIGURATION
// BUILD : 0.7.0
//======================================================================

string GROUP_PD = "Premium / Discount Engine"

bool cfg_enablePDFilter = input.bool(true, "Enable Premium / Discount Filter", group = GROUP_PD)

float cfg_pdEquilibrium = input.float(0.50, "Equilibrium Level", minval = 0.10, maxval = 0.90, step = 0.05, group = GROUP_PD)

//======================================================================
// MODULE 07.02 - DEALING RANGE ENGINE
// BUILD : 0.7.1
//======================================================================

//----------------------------------------------------
// DEALING RANGE
//----------------------------------------------------

float e_dealingRangeHigh = e_lastSwingHigh

float e_dealingRangeLow = e_lastSwingLow

float e_equilibrium = e_dealingRangeLow + ((e_dealingRangeHigh - e_dealingRangeLow) * cfg_pdEquilibrium)

bool e_dealingRangeReady = not na(e_dealingRangeHigh) and not na(e_dealingRangeLow)

//======================================================================
// MODULE 07.03 - PREMIUM / DISCOUNT ZONES
// BUILD : 0.7.2
//======================================================================

//----------------------------------------------------
// PREMIUM / DISCOUNT ZONES
//----------------------------------------------------

bool e_inPremium = e_dealingRangeReady and close > e_equilibrium

bool e_inDiscount = e_dealingRangeReady and close < e_equilibrium

bool e_atEquilibrium = e_dealingRangeReady and close == e_equilibrium

//======================================================================
// MODULE 07.04 - PREMIUM / DISCOUNT CONFIDENCE
// BUILD : 0.7.3
//======================================================================

//----------------------------------------------------
// PREMIUM / DISCOUNT CONFIDENCE
//----------------------------------------------------

int e_pdConfidence = 0

e_pdConfidence := 0

if e_dealingRangeReady
    e_pdConfidence += 30

if e_inPremium or e_inDiscount
    e_pdConfidence += 40

if not e_atEquilibrium
    e_pdConfidence += 30

bool e_pdStrong = e_pdConfidence >= 70

//======================================================================
// MODULE 08.01 - ORDER BLOCK CONFIGURATION
// BUILD : 0.8.0
//======================================================================

string GROUP_OB = "Order Block Engine"

bool cfg_enableOBFilter = input.bool(true, "Enable Order Block Filter", group = GROUP_OB)

int cfg_obLookback = input.int(20, "Order Block Lookback", minval = 5, group = GROUP_OB)

//======================================================================
// MODULE 08.02 - BULLISH ORDER BLOCK ENGINE
// BUILD : 0.8.1
//======================================================================

float e_bullishOBHigh = ta.valuewhen(e_bosBullish, high[1], 0)

float e_bullishOBLow = ta.valuewhen(e_bosBullish, low[1], 0)

bool e_bullishOBReady = not na(e_bullishOBHigh) and not na(e_bullishOBLow)

//======================================================================
// MODULE 08.03 - BEARISH ORDER BLOCK ENGINE
// BUILD : 0.8.2
//======================================================================

float e_bearishOBHigh = ta.valuewhen(e_bosBearish, high[1], 0)

float e_bearishOBLow = ta.valuewhen(e_bosBearish, low[1], 0)

bool e_bearishOBReady = not na(e_bearishOBHigh) and not na(e_bearishOBLow)

//======================================================================
// MODULE 08.04 - ORDER BLOCK VALIDATION
// BUILD : 0.8.3
//======================================================================

bool e_validBullishOB = e_bullishOBReady and e_structureBullish and e_inDiscount

bool e_validBearishOB = e_bearishOBReady and e_structureBearish and e_inPremium

bool e_obReady = e_validBullishOB or e_validBearishOB

//======================================================================
// MODULE 08.05 - ORDER BLOCK CONFIDENCE
// BUILD : 0.8.4
//======================================================================

int e_obConfidence = 0

e_obConfidence := 0

if e_bullishOBReady or e_bearishOBReady
    e_obConfidence += 30

if e_obReady
    e_obConfidence += 40

if e_validBullishOB or e_validBearishOB
    e_obConfidence += 30

bool e_obStrong = e_obConfidence >= 70

//======================================================================
// MODULE 09.01 - MITIGATION CONFIGURATION
// BUILD : 0.9.0
//======================================================================

string GROUP_MITIGATION = "Mitigation Engine"

bool cfg_enableMitigationFilter = input.bool(true, "Enable Mitigation Filter", group = GROUP_MITIGATION)

int cfg_mitigationBufferTicks = input.int(2, "Mitigation Buffer (Ticks)", minval = 0, maxval = 10, group = GROUP_MITIGATION)

float e_mitigationBuffer = cfg_mitigationBufferTicks * syminfo.mintick

//======================================================================
// MODULE 09.02 - BULLISH MITIGATION ENGINE
// BUILD : 0.9.1
//======================================================================

bool e_bullishMitigation = e_bullishOBReady and low <= (e_bullishOBHigh + e_mitigationBuffer)

bool e_bullishMitigationReady = e_bullishMitigation

//======================================================================
// MODULE 09.03 - BEARISH MITIGATION ENGINE
// BUILD : 0.9.2
//======================================================================

bool e_bearishMitigation = e_bearishOBReady and high >= (e_bearishOBLow - e_mitigationBuffer)

bool e_bearishMitigationReady = e_bearishMitigation

//======================================================================
// MODULE 09.04 - MITIGATION VALIDATION
// BUILD : 0.9.3
//======================================================================

bool e_validBullishMitigation = e_bullishMitigationReady and e_validBullishOB

bool e_validBearishMitigation = e_bearishMitigationReady and e_validBearishOB

bool e_mitigationReady = e_validBullishMitigation or e_validBearishMitigation

//======================================================================
// MODULE 09.05 - MITIGATION CONFIDENCE
// BUILD : 0.9.4
//======================================================================

int e_mitigationConfidence = 0

e_mitigationConfidence := 0

if e_bullishMitigationReady or e_bearishMitigationReady
    e_mitigationConfidence += 30

if e_mitigationReady
    e_mitigationConfidence += 40

if e_validBullishMitigation or e_validBearishMitigation
    e_mitigationConfidence += 30

bool e_mitigationStrong = e_mitigationConfidence >= 70


