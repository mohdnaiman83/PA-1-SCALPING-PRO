if tradeRunning and tradeSnapshotTaken

    //----------------------------------------------
    // Bars in Trade
    //----------------------------------------------

    tradeBars := bar_index - tradeOpenBar

    //----------------------------------------------
    // Highest / Lowest Since Entry
    //----------------------------------------------

    if na(tradeHighest)

        tradeHighest := high

    else

        tradeHighest := math.max(
            tradeHighest,
            high)

    if na(tradeLowest)

        tradeLowest := low

    else

        tradeLowest := math.min(
            tradeLowest,
            low)

    //----------------------------------------------
    // LONG TRADE
    //----------------------------------------------

    if tradeDirection == DIR_LONG

        tradeFloating :=
             close - tradeEntry

        tradeMFE :=
             tradeHighest - tradeEntry

        tradeMAE :=
             tradeEntry - tradeLowest

    //----------------------------------------------
    // SHORT TRADE
    //----------------------------------------------

    else if tradeDirection == DIR_SHORT

        tradeFloating :=
             tradeEntry - close

        tradeMFE :=
             tradeEntry - tradeLowest

        tradeMAE :=
             tradeHighest - tradeEntry

