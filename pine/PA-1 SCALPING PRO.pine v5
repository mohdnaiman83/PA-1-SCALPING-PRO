if cfg_enableRisk and ex_canTrade and not na(rm_riskDistance)

    if ex_direction == DIR_LONG

        rm_takeProfit := rm_entry + (rm_riskDistance * rm_riskReward)

    else if ex_direction == DIR_SHORT

        rm_takeProfit := rm_entry - (rm_riskDistance * rm_riskReward)

//--------------------------------------------------
// VALIDATION
//--------------------------------------------------

if not na(rm_entry) and not na(rm_takeProfit)

    if ex_direction == DIR_LONG and rm_takeProfit <= rm_entry

        rm_takeProfit := na

