// Dashboard Summary
//--------------------------------------------------
string ts_dashboardHealth =
     ts_dashboardIntegrity and
     ts_dashboardProtected and
     not ts_dashboardTimeout and
     not ts_dashboardDuplicate ?
     "OK" : "CHECK"

//======================================================================
// MODULE 19.08 - MODULE API ENGINE
//======================================================================

//--------------------------------------------------
// Public API
//--------------------------------------------------
bool   m19_stateValid      = ts_isValid
bool   m19_transitionOK    = ts_transitionOK
bool   m19_integrityOK     = ts_integrityOK
bool   m19_stateProtected  = ts_stateProtected
bool   m19_timeoutActive   = ts_timeoutActive
bool   m19_duplicateState  = ts_duplicateState

string m19_tradeState      = g_tradeState
string m19_previousState   = ts_prevState

//--------------------------------------------------
// Overall Health
//--------------------------------------------------
bool m19_engineHealthy =
     m19_stateValid and
     m19_transitionOK and
     m19_integrityOK and
     m19_stateProtected and
     not m19_timeoutActive and
     not m19_duplicateState
     
//======================================================================
// MODULE 20.01 - TRADE LIFECYCLE INITIALIZATION
//======================================================================

//--------------------------------------------------
// Lifecycle Status
//--------------------------------------------------
const string LC_IDLE      = "IDLE"
const string LC_READY     = "READY"
const string LC_ACTIVE    = "ACTIVE"
const string LC_BREAKEVEN = "BREAKEVEN"
const string LC_EXITED    = "EXITED"

//--------------------------------------------------
// Lifecycle Variables
//--------------------------------------------------
var string lc_state      = LC_IDLE
var int    lc_entryBar   = na
var int    lc_exitBar    = na
var int    lc_tradeBars  = 0

//--------------------------------------------------
// Lifecycle Reset
//--------------------------------------------------
if lc_state == LC_IDLE
    lc_tradeBars := 0

//--------------------------------------------------
// Active Trade Duration
//--------------------------------------------------
if lc_state == LC_ACTIVE or lc_state == LC_BREAKEVEN
    lc_tradeBars := bar_index - lc_entryBar

//======================================================================
// MODULE 20.02 - ENTRY REGISTRATION ENGINE
//======================================================================

//--------------------------------------------------
// Entry Detection
//--------------------------------------------------
bool lc_newEntry =
     m19_engineHealthy and
     (g_tradeState == TS_BUY_ACTIVE or
      g_tradeState == TS_SELL_ACTIVE) and
     lc_state != LC_ACTIVE

//--------------------------------------------------
// Register Entry
//--------------------------------------------------
if lc_newEntry

    lc_state     := LC_ACTIVE
    lc_entryBar  := bar_index
    lc_exitBar   := na
    lc_tradeBars := 0

//======================================================================
// MODULE 20.03 - ACTIVE TRADE MONITOR
//======================================================================

//--------------------------------------------------
// Active Trade Status
//--------------------------------------------------
bool lc_isActive =
     lc_state == LC_ACTIVE or
     lc_state == LC_BREAKEVEN

//--------------------------------------------------
// Trade Duration
//--------------------------------------------------
if lc_isActive and not na(lc_entryBar)
    lc_tradeBars := bar_index - lc_entryBar

//--------------------------------------------------
// Active Direction
//--------------------------------------------------
string lc_direction =
     g_tradeState == TS_BUY_ACTIVE  ? "BUY" :
     g_tradeState == TS_SELL_ACTIVE ? "SELL" :
     "NONE"

//======================================================================
// MODULE 20.04 - BREAK-EVEN MANAGER
//======================================================================

//--------------------------------------------------
// Break-even Status
//--------------------------------------------------
bool lc_breakEven =
     g_tradeState == TS_BREAK_EVEN

//--------------------------------------------------
// Lifecycle Update
//--------------------------------------------------
if lc_breakEven
    lc_state := LC_BREAKEVEN

//--------------------------------------------------
// Break-even Bar
//--------------------------------------------------
var int lc_breakEvenBar = na

if lc_breakEven and na(lc_breakEvenBar)
    lc_breakEvenBar := bar_index

if lc_state == LC_IDLE
    lc_breakEvenBar := na

//======================================================================
// MODULE 20.05 - PARTIAL TAKE PROFIT MANAGER
//======================================================================

//--------------------------------------------------
// Partial TP Status
//--------------------------------------------------
bool lc_partialTP =
     g_tradeState == TS_BREAK_EVEN

//--------------------------------------------------
// Partial TP Bar
//--------------------------------------------------
var int lc_partialTPBar = na

if lc_partialTP and na(lc_partialTPBar)
    lc_partialTPBar := bar_index

//--------------------------------------------------
// Reset
//--------------------------------------------------
if lc_state == LC_IDLE
    lc_partialTPBar := na

//======================================================================
// MODULE 20.06 - TRAILING STOP MANAGER
//======================================================================

//--------------------------------------------------
// Trailing Stop Status
//--------------------------------------------------
bool lc_trailingActive =
     lc_state == LC_BREAKEVEN

//--------------------------------------------------
// Trailing Start Bar
//--------------------------------------------------
var int lc_trailingBar = na

if lc_trailingActive and na(lc_trailingBar)
    lc_trailingBar := bar_index

//--------------------------------------------------
// Reset
//--------------------------------------------------
if lc_state == LC_IDLE
    lc_trailingBar := na

//======================================================================
// MODULE 20.07 - EXIT SUMMARY ENGINE
//======================================================================

//--------------------------------------------------
// Exit Detection
//--------------------------------------------------
bool lc_tradeClosed =
     g_tradeState == TS_TP_HIT or
     g_tradeState == TS_SL_HIT

//--------------------------------------------------
// Register Exit
//--------------------------------------------------
if lc_tradeClosed

    lc_exitBar := bar_index
    lc_state   := LC_EXITED

//--------------------------------------------------
// Trade Duration
//--------------------------------------------------
int lc_totalBars = not na(lc_entryBar) and not na(lc_exitBar) ? lc_exitBar - lc_entryBar : 0

//======================================================================
// MODULE 20.08 - PUBLIC API ENGINE
//======================================================================

//--------------------------------------------------
// Public API
//--------------------------------------------------
string m20_lifecycleState = lc_state

bool   m20_isActive       = lc_isActive
bool   m20_breakEven      = lc_breakEven
bool   m20_partialTP      = lc_partialTP
bool   m20_trailingActive = lc_trailingActive
bool   m20_tradeClosed    = lc_tradeClosed

int    m20_tradeBars      = lc_tradeBars
int    m20_totalBars      = lc_totalBars

//--------------------------------------------------
// Engine Health
//--------------------------------------------------
bool m20_engineHealthy =
     m19_engineHealthy and
     not na(lc_entryBar)

//======================================================================
// MODULE 21.01 - PERFORMANCE INITIALIZATION
//======================================================================

//--------------------------------------------------
// Performance Variables
//--------------------------------------------------
var int   pf_totalTrades = 0
var int   pf_totalWins   = 0
var int   pf_totalLosses = 0

var float pf_winRate     = 0.0
var float pf_score       = 0.0

//--------------------------------------------------
// Engine Ready
//--------------------------------------------------
bool pf_engineReady =
     m20_engineHealthy
     
//======================================================================
// MODULE 21.02 - TRADE COUNTER
//======================================================================

//--------------------------------------------------
// Trade Close Detection
//--------------------------------------------------
bool pf_newTrade =
     lc_tradeClosed and
     barstate.isconfirmed

//--------------------------------------------------
// Prevent Double Count
//--------------------------------------------------
var int pf_lastCountBar = na

if pf_newTrade and pf_lastCountBar != bar_index
    pf_totalTrades += 1
    pf_lastCountBar := bar_index
    
 //======================================================================
// MODULE 21.03 - WIN / LOSS COUNTER
//======================================================================

//--------------------------------------------------
// Trade Result
//--------------------------------------------------
bool pf_isWin  = g_tradeState == TS_TP_HIT
bool pf_isLoss = g_tradeState == TS_SL_HIT

//--------------------------------------------------
// Prevent Double Count
//--------------------------------------------------
var int pf_lastResultBar = na

if lc_tradeClosed and pf_lastResultBar != bar_index

    if pf_isWin
        pf_totalWins += 1

    if pf_isLoss
        pf_totalLosses += 1

    pf_lastResultBar := bar_index

 //======================================================================
// MODULE 21.04 - WIN RATE CALCULATOR
//======================================================================

//--------------------------------------------------
// Win Rate
//--------------------------------------------------
if pf_totalTrades > 0
    pf_winRate := (pf_totalWins * 100.0) / pf_totalTrades
else
    pf_winRate := 0.0

//--------------------------------------------------
// Trade Balance
//--------------------------------------------------
int pf_netWins = pf_totalWins - pf_totalLosses

//======================================================================
// MODULE 21.05 - AVERAGE TRADE DURATION
//======================================================================

//--------------------------------------------------
// Total Trade Bars
//--------------------------------------------------
var int pf_totalTradeBars = 0

//--------------------------------------------------
// Accumulate Duration
//--------------------------------------------------
if lc_tradeClosed and barstate.isconfirmed
    pf_totalTradeBars += lc_totalBars

//--------------------------------------------------
// Average Duration
//--------------------------------------------------
float pf_avgTradeBars = 0.0

if pf_totalTrades > 0
    pf_avgTradeBars := pf_totalTradeBars / pf_totalTrades

//======================================================================
// MODULE 21.06 - PERFORMANCE SCORE ENGINE
//======================================================================

//--------------------------------------------------
// Performance Score
//--------------------------------------------------
if pf_winRate >= 80
    pf_score := 100
else if pf_winRate >= 70
    pf_score := 90
else if pf_winRate >= 60
    pf_score := 80
else if pf_winRate >= 50
    pf_score := 70
else if pf_winRate >= 40
    pf_score := 60
else
    pf_score := 50

//--------------------------------------------------
// Performance Grade
//--------------------------------------------------
string pf_grade =
     pf_score >= 95 ? "A+" :
     pf_score >= 90 ? "A"  :
     pf_score >= 80 ? "B"  :
     pf_score >= 70 ? "C"  :
     "D"

//======================================================================
// MODULE 21.07 - DASHBOARD ANALYTICS ENGINE
//======================================================================

//--------------------------------------------------
// Dashboard Analytics
//--------------------------------------------------
string pf_dashboardTrades =
     str.tostring(pf_totalTrades)

string pf_dashboardWins =
     str.tostring(pf_totalWins)

string pf_dashboardLosses =
     str.tostring(pf_totalLosses)

string pf_dashboardWinRate =
     str.tostring(math.round(pf_winRate, 2)) + "%"

string pf_dashboardScore =
     str.tostring(pf_score)

string pf_dashboardGrade =
     pf_grade

//======================================================================
// MODULE 21.08 - PUBLIC API ENGINE
//======================================================================

//--------------------------------------------------
// Public API
//--------------------------------------------------
int    m21_totalTrades    = pf_totalTrades
int    m21_totalWins      = pf_totalWins
int    m21_totalLosses    = pf_totalLosses

float  m21_winRate        = pf_winRate
float  m21_score          = pf_score

string m21_grade          = pf_grade

float  m21_avgTradeBars   = pf_avgTradeBars

bool   m21_engineHealthy  =
       m20_engineHealthy and
       pf_engineReady


//======================================================================
// MODULE 22.01 - SIGNAL QUALITY INITIALIZATION
//======================================================================

//--------------------------------------------------
// Quality Variables
//--------------------------------------------------
var float sq_score = 0.0
var string sq_grade = "N/A"

//--------------------------------------------------
// Weight Configuration
//--------------------------------------------------
const float SQ_MAX_SCORE = 100.0

//--------------------------------------------------
// Engine Ready
//--------------------------------------------------
bool sq_engineReady =
     m21_engineHealthy
     
//======================================================================
// MODULE 22.02 - MARKET BIAS SCORE
//======================================================================

float sq_biasScore = 0.0

if m21_engineHealthy

    if e_marketBias == BIAS_BULL and g_signal == SIGNAL_BUY
        sq_biasScore := 20.0

    else if e_marketBias == BIAS_BEAR and g_signal == SIGNAL_SELL
        sq_biasScore := 20.0

    else
        sq_biasScore := 0.0

//======================================================================
// MODULE 22.03 - SIGNAL BIAS SCORE
//======================================================================

//--------------------------------------------------
// Signal Bias Score
//--------------------------------------------------
float sq_signalScore = 0.0

if m21_engineHealthy

    if e_signalBias == SIG_BUY and g_signal == SIGNAL_BUY
        sq_signalScore := 20.0

    else if e_signalBias == SIG_SELL and g_signal == SIGNAL_SELL
        sq_signalScore := 20.0

    else
        sq_signalScore := 0.0
        
//======================================================================
// MODULE 22.04 - CONFIDENCE SCORE
//======================================================================

//--------------------------------------------------
// Confidence Score
//--------------------------------------------------
float sq_confidenceScore = 0.0

if m21_engineHealthy

    if e_tradeConfidence >= 90
        sq_confidenceScore := 20.0

    else if e_tradeConfidence >= 80
        sq_confidenceScore := 18.0

    else if e_tradeConfidence >= 70
        sq_confidenceScore := 16.0

    else if e_tradeConfidence >= 60
        sq_confidenceScore := 12.0

    else
        sq_confidenceScore := 0.0

//======================================================================
// MODULE 22.05 - TRADE GRADE SCORE
//======================================================================

//--------------------------------------------------
// Trade Grade Score
//--------------------------------------------------
float sq_gradeScore = 0.0

if m21_engineHealthy

    if e_tradeGrade >= 90
        sq_gradeScore := 20.0

    else if e_tradeGrade >= 80
        sq_gradeScore := 18.0

    else if e_tradeGrade >= 70
        sq_gradeScore := 16.0

    else if e_tradeGrade >= 60
        sq_gradeScore := 12.0

    else
        sq_gradeScore := 0.0    

//======================================================================
// MODULE 22.06 - FINAL QUALITY SCORE
//======================================================================

//--------------------------------------------------
// Final Quality Score
//--------------------------------------------------
sq_score :=
      sq_biasScore +
      sq_signalScore +
      sq_confidenceScore +
      sq_gradeScore

//--------------------------------------------------
// Cap Score
//--------------------------------------------------
sq_score := math.min(sq_score, SQ_MAX_SCORE)

//--------------------------------------------------
// Final Grade
//--------------------------------------------------
if sq_score >= 95
    sq_grade := "A+"
else if sq_score >= 90
    sq_grade := "A"
else if sq_score >= 80
    sq_grade := "B"
else if sq_score >= 70
    sq_grade := "C"
else
    sq_grade := "D"

//======================================================================
// MODULE 22.07 - DASHBOARD QUALITY ENGINE
//======================================================================

//--------------------------------------------------
// Dashboard Quality
//--------------------------------------------------
string sq_dashboardScore =
     str.tostring(math.round(sq_score, 0))

string sq_dashboardGrade =
     sq_grade

string sq_dashboardStars =
     sq_score >= 95 ? "★★★★★" :
     sq_score >= 90 ? "★★★★☆" :
     sq_score >= 80 ? "★★★☆☆" :
     sq_score >= 70 ? "★★☆☆☆" :
     "★☆☆☆☆"

//======================================================================
// MODULE 22.08 - PUBLIC API ENGINE
//======================================================================

//--------------------------------------------------
// Public API
//--------------------------------------------------
float  m22_qualityScore   = sq_score
string m22_qualityGrade   = sq_grade

float  m22_biasScore      = sq_biasScore
float  m22_signalScore    = sq_signalScore
float  m22_confidenceScore= sq_confidenceScore
float  m22_gradeScore     = sq_gradeScore

bool   m22_engineHealthy  =
       m21_engineHealthy and
       sq_engineReady
       
                                
