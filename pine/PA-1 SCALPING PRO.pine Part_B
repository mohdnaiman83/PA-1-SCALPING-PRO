//-------------------------
// Trade Lifecycle
//-------------------------
const int TRADE_WAIT   = 0
const int TRADE_READY  = 1
const int TRADE_ACTIVE = 2
const int TRADE_BE     = 3
const int TRADE_TP     = 4
const int TRADE_SL     = 5
const int TRADE_CLOSE  = 6

//-------------------------
// Runtime Variables
//-------------------------
var int tradeState = TRADE_WAIT
var int tradeDirection = 0      // 1 = BUY, -1 = SELL

var float tradeEntry = na
var float tradeSL = na
var float tradeTP = na

var int tradeOpenBar = na
var int tradeCloseBar = na

var bool tradeRunning = false

//--------------------------------------------------
// SIGNAL EDGE DETECTION
//--------------------------------------------------

var string tradeLastSignal = "WAIT"
var bool tradeNewSignal = false

//====================================================
// MODULE 17.02 - TRADE STATE ENGINE
// BUILD : 0.6.0
//====================================================

//--------------------------------------------------
// SIGNAL EDGE DETECTION
//--------------------------------------------------

tradeNewSignal := false

if g_dashboardSignal != tradeLastSignal

    if g_dashboardSignal == SIGNAL_BUY or
       g_dashboardSignal == SIGNAL_SELL

        tradeNewSignal := true

    tradeLastSignal := g_dashboardSignal

//--------------------------------------------------
// READY STATE
//--------------------------------------------------

if not tradeRunning and tradeNewSignal

    tradeState := TRADE_READY

    if g_dashboardSignal == SIGNAL_BUY
        g_tradeState := TS_BUY_READY
    else if g_dashboardSignal == SIGNAL_SELL
        g_tradeState := TS_SELL_READY
    else
        g_tradeState := TS_WAIT

///-------------------------
// Direction
//-------------------------

if tradeRunning or tradeState == TRADE_READY
    tradeDirection := g_dashboardSignal == SIGNAL_BUY ? DIR_LONG : DIR_SHORT

//-------------------------
// ACTIVE State
//-------------------------

if tradeState == TRADE_READY and barstate.isconfirmed

    tradeState := TRADE_ACTIVE
    tradeRunning := true

    if tradeDirection == DIR_LONG
        g_tradeState := TS_BUY_ACTIVE
    else if tradeDirection == DIR_SHORT
        g_tradeState := TS_SELL_ACTIVE

