    lc_state := LC_BREAKEVEN

//--------------------------------------------------
// Break-even Bar
//--------------------------------------------------
var int lc_breakEvenBar = na

if lc_breakEven and na(lc_breakEvenBar)
    lc_breakEvenBar := bar_index

if lc_state == LC_IDLE
    lc_breakEvenBar := na

//======================================================================
// MODULE 20.05 - PARTIAL TAKE PROFIT MANAGER
