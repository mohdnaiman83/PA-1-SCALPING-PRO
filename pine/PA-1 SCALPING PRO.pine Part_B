//--------------------------------------------------

var bool tradeSnapshotTaken = false

var float snapEntry = na
var float snapSL = na
var float snapTP = na

var int snapDirection = 0

var int snapOpenBar = na
var int snapOpenTime = na

//--------------------------------------------------
// RESET
//--------------------------------------------------

if not tradeRunning

    tradeSnapshotTaken := false

    snapEntry := na
    snapSL := na
    snapTP := na

    snapDirection := 0

    snapOpenBar := na
    snapOpenTime := na

//--------------------------------------------------
// SNAPSHOT ENGINE
//--------------------------------------------------

if tradeRunning and not tradeSnapshotTaken

    snapEntry := g_dashboardEntry
    snapSL := g_dashboardSL
    snapTP := g_dashboardTP

    snapDirection := tradeDirection

    snapOpenBar := bar_index
    snapOpenTime := time

    tradeEntry := snapEntry
    tradeSL := snapSL
    tradeTP := snapTP

    tradeOpenBar := snapOpenBar

    tradeSnapshotTaken := true

//--------------------------------------------------
// VALIDATION
//--------------------------------------------------

bool snapshotReady =
     tradeSnapshotTaken and
     not na(snapEntry) and
     not na(snapSL) and
     not na(snapTP)

//--------------------------------------------------
// DEBUG
//--------------------------------------------------

if cfg_debugMode and barstate.islast

    label.new(
         bar_index,
         low,
         "===== MODULE 17.03 =====" +
         "\nSnapshot : " + str.tostring(tradeSnapshotTaken) +
         "\nEntry : " + str.tostring(snapEntry) +
         "\nSL : " + str.tostring(snapSL) +
         "\nTP : " + str.tostring(snapTP) +
         "\nDirection : " + str.tostring(snapDirection) +
         "\nOpen Bar : " + str.tostring(snapOpenBar),
         style = label.style_label_up,
         color = color.new(color.green, 75),
         textcolor = color.white,
         size = size.small)

//======================================================================
// MODULE 17.04 - TRADE TRACKING ENGINE
// BUILD : 0.6.2
//======================================================================

//--------------------------------------------------
// TRACKING VARIABLES
//--------------------------------------------------

var int tradeBars = 0

var float tradeHighest = na
var float tradeLowest = na

var float tradeMFE = 0.0
var float tradeMAE = 0.0

var float tradeFloating = 0.0

//--------------------------------------------------
// RESET
//--------------------------------------------------

if not tradeRunning

    tradeBars := 0

    tradeHighest := na
    tradeLowest := na

    tradeMFE := 0.0
    tradeMAE := 0.0

    tradeFloating := 0.0

//--------------------------------------------------
// TRACKING ENGINE
//--------------------------------------------------

if tradeRunning and tradeSnapshotTaken

    //----------------------------------------------
    // Bars in Trade
    //----------------------------------------------

    tradeBars := bar_index - tradeOpenBar

    //----------------------------------------------
    // Highest / Lowest Since Entry
    //----------------------------------------------

    if na(tradeHighest)

        tradeHighest := high

    else

        tradeHighest := math.max(
            tradeHighest,
            high)

    if na(tradeLowest)

        tradeLowest := low

    else

        tradeLowest := math.min(
            tradeLowest,
            low)

    //----------------------------------------------
    // LONG TRADE
    //----------------------------------------------

    if tradeDirection == DIR_LONG

        tradeFloating :=
             close - tradeEntry

        tradeMFE :=
             tradeHighest - tradeEntry

        tradeMAE :=
             tradeEntry - tradeLowest

    //----------------------------------------------
    // SHORT TRADE
    //----------------------------------------------

    else if tradeDirection == DIR_SHORT

        tradeFloating :=
             tradeEntry - close

        tradeMFE :=
             tradeEntry - tradeLowest

        tradeMAE :=
             tradeHighest - tradeEntry

//--------------------------------------------------
// VALIDATION
//--------------------------------------------------

bool trackingReady =
     tradeRunning and
     tradeSnapshotTaken

//--------------------------------------------------
// DEBUG
//--------------------------------------------------

if cfg_debugMode and
   barstate.islast and
   trackingReady

    label.new(

         bar_index,

         high,

         "===== MODULE 17.04 =====" +

         "\nBars : " + str.tostring(tradeBars) +

         "\nFloating : " + str.tostring(tradeFloating) +

         "\nMFE : " + str.tostring(tradeMFE) +

         "\nMAE : " + str.tostring(tradeMAE) +

         "\nHigh : " + str.tostring(tradeHighest) +

         "\nLow : " + str.tostring(tradeLowest),

         style = label.style_label_left,

         color = color.new(color.purple,70),

         textcolor = color.white,

         size = size.small)

 //======================================================================
// MODULE 17.05 - EXIT ENGINE
// BUILD : 0.6.3
//======================================================================

//--------------------------------------------------
// EXIT VARIABLES
//--------------------------------------------------

var bool tradeExit = false

var string tradeExitReason = "NONE"

var float tradeExitPrice = na

var int tradeExitBar = na

//--------------------------------------------------
// RESET
//--------------------------------------------------

if not tradeRunning

    tradeExit := false
    tradeExitReason := "NONE"
    tradeExitPrice := na
    tradeExitBar := na

//--------------------------------------------------
// EXIT ENGINE
//--------------------------------------------------

if tradeRunning and tradeSnapshotTaken

    //------------------------------------------
    // LONG
    //------------------------------------------

    if tradeDirection == DIR_LONG

        if low <= tradeSL

            tradeExit := true
            tradeExitReason := "STOP LOSS"
            tradeExitPrice := tradeSL

        else if high >= tradeTP

            tradeExit := true
            tradeExitReason := "TAKE PROFIT"
            tradeExitPrice := tradeTP

    //------------------------------------------
    // SHORT
    //------------------------------------------

    else if tradeDirection == DIR_SHORT

        if high >= tradeSL

            tradeExit := true
            tradeExitReason := "STOP LOSS"
            tradeExitPrice := tradeSL

        else if low <= tradeTP

            tradeExit := true
            tradeExitReason := "TAKE PROFIT"
            tradeExitPrice := tradeTP

//--------------------------------------------------
// CLOSE TRADE
//--------------------------------------------------

if tradeExit

    tradeCloseBar := bar_index
    tradeRunning := false
    tradeState := TRADE_CLOSE
    tradeNewSignal := false

    if tradeExitReason == "TAKE PROFIT"
        g_tradeState := TS_TP_HIT
    else if tradeExitReason == "STOP LOSS"
        g_tradeState := TS_SL_HIT
    else
        g_tradeState := TS_WAIT

    tradeExitBar := bar_index

//--------------------------------------------------
// DEBUG
//--------------------------------------------------

if cfg_debugMode and
   barstate.islast

    label.new(

        bar_index,

        high,

        "===== MODULE 17.05 =====" +

        "\nRunning : " + str.tostring(tradeRunning) +

