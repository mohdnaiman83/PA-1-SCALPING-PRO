var bool   ts_hasChanged  = false
var bool   ts_isValid     = true

//======================================================
// MODULE 19.02
// STATE TRANSITION ENGINE
//======================================================

// Save previous state
if ts_hasChanged
    ts_prevState := g_tradeState

//------------------------------------------------------
// Transition Validation
//------------------------------------------------------
bool ts_transitionOK = true

switch g_tradeState

    TS_NO_TRADE =>
        ts_transitionOK := true

    TS_WAIT =>
        ts_transitionOK := true

    TS_BUY_READY =>
        ts_transitionOK := ts_prevState == TS_WAIT or
                           ts_prevState == TS_NO_TRADE

    TS_SELL_READY =>
        ts_transitionOK := ts_prevState == TS_WAIT or
                           ts_prevState == TS_NO_TRADE

    TS_BUY_ACTIVE =>
        ts_transitionOK := ts_prevState == TS_BUY_READY

    TS_SELL_ACTIVE =>
        ts_transitionOK := ts_prevState == TS_SELL_READY

    TS_BREAK_EVEN =>
        ts_transitionOK := ts_prevState == TS_BUY_ACTIVE or
                           ts_prevState == TS_SELL_ACTIVE

    TS_TP_HIT =>
        ts_transitionOK := ts_prevState == TS_BREAK_EVEN or
                           ts_prevState == TS_BUY_ACTIVE or
                           ts_prevState == TS_SELL_ACTIVE

    TS_SL_HIT =>
        ts_transitionOK := true

    //======================================================================
// MODULE 19.03 - STATE INTEGRITY MONITOR
//======================================================================

//--------------------------------------------------
// Integrity Flags
//--------------------------------------------------
var bool ts_integrityOK      = true
var bool ts_signalMismatch   = false
var bool ts_directionMismatch = false

//--------------------------------------------------
// Reset
//--------------------------------------------------
ts_integrityOK       := true
ts_signalMismatch    := false
ts_directionMismatch := false

//--------------------------------------------------
// Signal ↔ Trade State Validation
//--------------------------------------------------
if g_tradeState == TS_BUY_READY and g_signal != SIGNAL_BUY
    ts_signalMismatch := true

if g_tradeState == TS_SELL_READY and g_signal != SIGNAL_SELL
    ts_signalMismatch := true

//--------------------------------------------------
// Direction ↔ Trade State Validation
//--------------------------------------------------
if g_tradeState == TS_BUY_ACTIVE and m17_tradeDirection != DIR_LONG
    ts_directionMismatch := true

if g_tradeState == TS_SELL_ACTIVE and m17_tradeDirection != DIR_SHORT
    ts_directionMismatch := true

//--------------------------------------------------
// Final Integrity Status
//--------------------------------------------------
ts_integrityOK :=
     not ts_signalMismatch and
     not ts_directionMismatch

//======================================================================
// MODULE 19.04 - STATE PROTECTION ENGINE
//======================================================================

//--------------------------------------------------
// Protection Variables
//--------------------------------------------------
var int    ts_lastStateBar = na
var string ts_lastState    = ""

//--------------------------------------------------
// State Change Detection
//--------------------------------------------------
bool ts_newState =
     g_tradeState != ts_lastState

//--------------------------------------------------
// Update State
//--------------------------------------------------
if ts_newState

    ts_lastState    := g_tradeState
    ts_lastStateBar := bar_index

//--------------------------------------------------
// Protection Flag
//--------------------------------------------------
bool ts_sameBarUpdate =
     ts_lastStateBar == bar_index and
     not ts_newState

//--------------------------------------------------
// Final Protection
//--------------------------------------------------
bool ts_stateProtected =
     not ts_sameBarUpdate

//======================================================================
// MODULE 19.05 - STATE TIMEOUT ENGINE
//======================================================================

//--------------------------------------------------
// Timeout Configuration
//--------------------------------------------------
int ts_timeoutBars = 15

//--------------------------------------------------
// State Age
//--------------------------------------------------
int ts_stateAge = na(ts_lastStateBar) ? 0 : bar_index - ts_lastStateBar

//--------------------------------------------------
// Timeout Detection
//--------------------------------------------------
bool ts_timeout =
     ts_stateAge >= ts_timeoutBars

//--------------------------------------------------
// Timeout Applies Only To Ready States
//--------------------------------------------------
bool ts_timeoutActive =
     ts_timeout and
     (g_tradeState == TS_BUY_READY or
      g_tradeState == TS_SELL_READY)

