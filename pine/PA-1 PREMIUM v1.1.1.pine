// © MohdNaiman (Premium Edition - Fixed)

//@version=6
indicator("PA-1 PREMIUM v1.1.1", overlay = true, max_labels_count = 500)

//==================================================
// M01 - INPUT & CONFIG
//==================================================

// ----- Swing -----
swingLen = input.int(5, "Swing Length (Filter Strength)", minval = 2, tooltip = "Tingkatkan nilai ini untuk tapis noise/spam")

// ----- Risk & Position Sizing -----
accountBalance = input.float(10000.0, "Account Balance ($)", minval = 1.0, tooltip = "Masukkan baki modal akaun semasa anda secara manual untuk pengiraan saiz lot")
accountRisk    = input.float(1.0, "Risk Per Trade (%)", minval = 0.1, maxval = 10.0, step = 0.1)
tpTicks        = input.int(100, "Take Profit (Ticks/Pips)", minval = 10)
slBuffer       = input.int(20, "SL Buffer (Ticks/Pips)", minval = 0)

// ----- Marker -----
showBO = input.bool(true, "Show Breakout Marker")
showRT = input.bool(true, "Show Retest Marker")

// ----- Dashboard -----
showDash     = input.bool(true, "Show Dashboard")
dashPosition = input.string("Bottom Right", "Dashboard Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"])

//==================================================
// CONSTANTS & GLOBALS
//==================================================

tick          = syminfo.mintick
BODY_CONFIRM  = 0.50
RT_BUFFER     = 2

var string setup = "WAIT"
var float structureHigh = na
var float structureLow  = na
var bool breakoutLock = false

// Retest State
var bool retestReady       = false
var bool waitingBuyReject  = false
var bool waitingSellReject = false
var bool retestDone = false
var int breakoutBar = na

// Signal Triggers
bool boBuy  = false
bool boSell = false
bool rtBuy  = false
bool rtSell = false

// Simpan ID Box untuk fungsi kemas kini zon
var box topBox = na
var box botBox = na

dashPos =
     dashPosition == "Top Left" ? position.top_left :
     dashPosition == "Top Right" ? position.top_right :
     dashPosition == "Bottom Left" ? position.bottom_left :
     position.bottom_right

//==================================================
// M02 - HIGH-QUALITY STRUCTURE ENGINE (Guna Pivot)
//==================================================

float pHi = ta.pivothigh(high, swingLen, swingLen)
float pLo = ta.pivotlow(low, swingLen, swingLen)

bool newHigh = not na(pHi)
bool newLow  = not na(pLo)

if newHigh
    structureHigh := pHi
    breakoutLock := false
    retestDone := false
    // Auto-Box: Padam kotak lama, bina kotak rintangan (Supply) baru
    box.delete(topBox)
    topBox := box.new(left=bar_index[swingLen], top=high[swingLen], right=bar_index, bottom=low[swingLen], 
                      bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 50), border_style=line.style_dashed)

if newLow
    structureLow := pLo
    breakoutLock := false
    retestDone := false
    // Auto-Box: Padam kotak lama, bina kotak sokongan (Demand) baru
    box.delete(botBox)
    botBox := box.new(left=bar_index[swingLen], top=high[swingLen], right=bar_index, bottom=low[swingLen], 
                      bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 50), border_style=line.style_dashed)

// Pemanjangan kotak zon ke kanan skrin secara dinamik
if not na(topBox)
    box.set_right(topBox, bar_index)
if not na(botBox)
    box.set_right(botBox, bar_index)

//==================================================
// M03 - BREAKOUT ENGINE
//==================================================

bodySize    = math.abs(close - open)
candleSize  = high - low
bodyPercent = candleSize > 0 ? bodySize / candleSize : 0.0

buyBreak  = not breakoutLock and not na(structureHigh) and close > structureHigh and bodyPercent >= BODY_CONFIRM
sellBreak = not breakoutLock and not na(structureLow) and close < structureLow and bodyPercent >= BODY_CONFIRM

if buyBreak
    boBuy := true
    setup := "BO BUY"
    breakoutLock := true
    retestReady := true
    waitingBuyReject := true
    waitingSellReject := false
    breakoutBar := bar_index
    retestDone := false

if sellBreak
    boSell := true
    setup := "BO SELL"
    breakoutLock := true
    retestReady := true
    waitingSellReject := true
    waitingBuyReject := false
    breakoutBar := bar_index
    retestDone := false

plotshape(showBO and boBuy, title="BO BUY", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="BO")
plotshape(showBO and boSell, title="BO SELL", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="BO")

//==================================================
// M04 - RETEST ENGINE
//==================================================

buyRetest  = retestReady and waitingBuyReject and not retestDone and bar_index > breakoutBar and low <= structureHigh + (RT_BUFFER * tick) and close > structureHigh and close > open
sellRetest = retestReady and waitingSellReject and not retestDone and bar_index > breakoutBar and high >= structureLow - (RT_BUFFER * tick) and close < structureLow and close < open

if buyRetest
    rtBuy := true
    setup := "RT BUY"
    retestDone := true
    retestReady := false
    waitingBuyReject := false

if sellRetest
    rtSell := true
    setup := "RT SELL"
    retestDone := true
    retestReady := false
    waitingSellReject := false

plotshape(showRT and rtBuy, title="RT BUY", style=shape.circle, location=location.belowbar, color=color.yellow, size=size.tiny, text="RT")
plotshape(showRT and rtSell, title="RT SELL", style=shape.circle, location=location.abovebar, color=color.orange, size=size.tiny, text="RT")

//==================================================
// M07 - DYNAMIC DASHBOARD & POSITION SIZING ENGINE (GOLD MYR OPTIMIZED)
//==================================================

var table dashTable = table.new(position = dashPos, columns = 2, rows = 6, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.gray)

float entryPrice = close
float targetSL   = na
float targetTP   = na

if setup == "BO BUY" or setup == "RT BUY"
    targetSL := structureLow - (slBuffer * tick)
    targetTP := entryPrice + (tpTicks * tick)
else if setup == "BO SELL" or setup == "RT SELL"
    targetSL := structureHigh + (slBuffer * tick)
    targetTP := entryPrice - (tpTicks * tick)

// --- PENARIKAN LIVE KADAR TUKARAN USD/MYR ---
float usdmyrRate = request.security("FX_IDC:USDMYR", "D", close)
// Jika data live gagal ditarik, kita guna kadar sandaran (fallback) RM4.40
if na(usdmyrRate) or usdmyrRate <= 0
    usdmyrRate := 4.40

// Tukar nilai input accountBalance (yang kini ditaip dalam MYR) menjadi USD untuk formula lot
float balanceInUSD = accountBalance / usdmyrRate

// Pengiraan jumlah risiko dalam USD untuk pasaran Gold dunia
float riskAmountUSD = balanceInUSD * (accountRisk / 100.0)
float priceDistance = not na(targetSL) ? math.abs(entryPrice - targetSL) : na
float calculatedLot = not na(priceDistance) and priceDistance > 0 ? riskAmountUSD / (priceDistance * 100.0) : 0.0

if showDash and barstate.islast
    // Header
    table.cell(dashTable, 0, 0, "PA-1 METRICS (MYR)", text_color=color.white, text_size=size.small, bgcolor=color.navy)
    table.cell(dashTable, 1, 0, "VALUES", text_color=color.white, text_size=size.small, bgcolor=color.navy)
    
    // Status Setup
    color statusColor = setup == "WAIT" ? color.gray : (str.contains(setup, "BUY") ? color.green : color.red)
    table.cell(dashTable, 0, 1, "Current Setup:", text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 1, setup, text_color=color.white, text_size=size.small, bgcolor=statusColor)
    
    // Paras Entry
    table.cell(dashTable, 0, 2, "Est. Entry Price:", text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 2, str.tostring(entryPrice, "#.##") + " USD", text_color=color.yellow, text_size=size.small)
    
    // Paras SL / TP
    table.cell(dashTable, 0, 3, "Target TP / SL:", text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 3, "TP: " + str.tostring(targetTP, "#.##") + " \nSL: " + str.tostring(targetSL, "#.##"), text_color=color.orange, text_size=size.small)
    
    // Kadar Tukaran Semasa
    table.cell(dashTable, 0, 4, "Live USD/MYR Rate:", text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 4, "RM " + str.tostring(usdmyrRate, "#.##"), text_color=color.white, text_size=size.small)

    // Cadangan Saiz Lot
    table.cell(dashTable, 0, 5, "Recommended Lot:", text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 5, str.tostring(calculatedLot, "0.02") + " Lots", text_color=color.lime, text_size=size.small)

//==================================================
// M08 - NOTIFICATION ALERTS ENGINE
//==================================================

if boBuy
    alert("PA-1 ALERT: Valid Breakout BUY Terbentuk pada " + syminfo.ticker + " (" + timeframe.period + ")!", alert.freq_once_per_bar_close)

if boSell
    alert("PA-1 ALERT: Valid Breakout SELL Terbentuk pada " + syminfo.ticker + " (" + timeframe.period + ")!", alert.freq_once_per_bar_close)

if rtBuy
    alert("PA-1 ALERT: Retest BUY Valid Dikesan pada " + syminfo.ticker + " (" + timeframe.period + ")!", alert.freq_once_per_bar_close)

if rtSell
    alert("PA-1 ALERT: Retest SELL Valid Dikesan pada " + syminfo.ticker + " (" + timeframe.period + ")!", alert.freq_once_per_bar_close)
